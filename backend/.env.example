# StepIn Platform Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SUPABASE (Required)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# GEMINI AI (Required)
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# AZURE (Optional - for deployment)
# =============================================================================
AZURE_STATIC_WEB_APPS_API_TOKEN=your-azure-swa-token
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_APP_SERVICE_PLAN=your-app-service-plan

# =============================================================================
# APPLICATION CONFIG
# =============================================================================
API_PORT=8001
FRONTEND_DOMAIN=your-app.azurewebsites.net
DEBUG=false